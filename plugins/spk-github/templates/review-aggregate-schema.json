{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-aggregate-schema.json",
  "title": "Aggregated code review",
  "description": "Two documents use this file. The aggregator agent writes `aggregated.json`: version plus findings, each with found_by. The tool's finalize step then writes `final.json`, which adds the computed pr, run, summary, verification, publication, prior_findings, coverage, and excluded_files fields. Agents never write the computed fields.",
  "type": "object",
  "required": ["version", "findings"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/aggregateFinding" }
    },
    "pr": {
      "type": "object",
      "properties": {
        "title": { "type": "string" }, "number": { "type": "integer" }, "url": { "type": "string" },
        "author": { "type": ["string", "null"] }, "base_ref": { "type": "string" }, "head_ref": { "type": "string" },
        "base_sha": { "type": "string" }, "head_sha": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "finalized_at": { "type": "string" },
        "snapshot_method": { "type": "string", "enum": ["worktree", "shallow_clone", "existing", "none"] },
        "snapshot_verified": { "type": "boolean" },
        "agents_invoked": { "type": "array", "items": { "type": "string" } },
        "agents_failed": { "type": "array", "items": { "type": "string" } },
        "config_source": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "description": "Computed by finalize from published findings. Never hand-written.",
      "required": ["headline", "blocking", "event", "counts", "coverage_complete"],
      "properties": {
        "headline": { "type": "string" },
        "blocking": { "type": "boolean", "description": "true only when a published severe finding was independently verified" },
        "event": { "type": "string", "enum": ["COMMENT", "REQUEST_CHANGES"], "description": "REQUEST_CHANGES only when blocking and the repository opted in with request_changes: true" },
        "counts": {
          "type": "object",
          "required": ["severe", "warning", "question"],
          "properties": {
            "severe": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "question": { "type": "integer", "minimum": 0 }
          }
        },
        "published": { "type": "integer", "minimum": 0 },
        "withheld": { "type": "integer", "minimum": 0 },
        "still_open": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "files_total": { "type": "integer", "minimum": 0 },
        "files_reviewable": { "type": "integer", "minimum": 0 },
        "files_reviewed": { "type": "integer", "minimum": 0 },
        "files_excluded": { "type": "integer", "minimum": 0 },
        "coverage_complete": { "type": "boolean" },
        "coverage_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "thread_id": { "type": "string" },
          "fingerprint": { "type": ["string", "null"] },
          "cr_id": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "thread_status": { "type": "string", "enum": ["open", "discussed", "resolved"] },
          "state": { "type": "string", "enum": ["not_found", "still_present", "accepted_risk", "reopened", "unknown"] },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "files_assigned", "files_reviewed", "findings", "status"],
        "properties": {
          "agent": { "type": "string" }, "role": { "type": "string" },
          "files_assigned": { "type": "integer" }, "files_reviewed": { "type": "integer" },
          "files_partial": { "type": "integer" }, "files_skipped": { "type": "integer" },
          "files_not_reported": { "type": "integer" }, "findings": { "type": "integer" },
          "status": { "type": "string", "enum": ["ok", "partial", "failed", "missing"] }
        }
      }
    },
    "excluded_files": {
      "type": "array",
      "items": { "type": "object", "required": ["path", "reason"], "properties": { "path": { "type": "string" }, "reason": { "type": "string" } } }
    }
  },

  "$defs": {
    "aggregateFinding": {
      "allOf": [{ "$ref": "review-common-schema.json#/$defs/finding" }],
      "required": ["found_by"],
      "properties": {
        "found_by": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Agents that raised this finding. Stored locally, never rendered on GitHub."
        },
        "prior_thread_id": {
          "type": ["string", "null"],
          "description": "Aggregator: the GraphQL thread id of an earlier review thread that describes the same issue, when the earlier comment has no fingerprint marker. The tool matches fingerprints itself."
        },
        "fingerprint": { "type": "string", "description": "Computed: category|slug|primary_file" },
        "verification": {
          "type": "object",
          "description": "Computed from verify/*.json",
          "properties": {
            "status": { "type": "string", "enum": ["verified", "rejected", "unverified", "not_required"] },
            "method": { "type": "string" }, "note": { "type": "string" }, "by": { "type": "string" },
            "level_before": { "$ref": "review-common-schema.json#/$defs/level" }
          }
        },
        "publication": {
          "type": "object",
          "description": "Computed",
          "properties": {
            "status": { "type": "string", "enum": ["candidate", "published", "withheld", "still_open", "accepted_risk", "rejected"] },
            "reason": { "type": "string" },
            "placement": { "type": "string", "enum": ["inline", "body"] }
          }
        },
        "prior_state": {
          "type": "object",
          "description": "Computed when the finding matches an earlier review thread",
          "properties": {
            "state": { "type": "string", "enum": ["still_present", "accepted_risk", "reopened", "unknown"] },
            "thread_url": { "type": ["string", "null"] },
            "thread_status": { "type": "string" },
            "severity_increased": { "type": "boolean" }
          }
        }
      }
    }
  }
}
