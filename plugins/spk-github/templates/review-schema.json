{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-schema.json",
  "title": "Specialist review output",
  "description": "Output of one specialist, primary, or verifier review agent. Counts, blocking status, and the overall assessment are computed by scripts/spk_review.py, not written by the agent. Shared definitions live in review-common-schema.json.",
  "type": "object",
  "required": ["version", "agent", "files", "findings"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "agent": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "spk-reviewer-primary",
            "spk-reviewer-security",
            "spk-reviewer-frontend",
            "spk-reviewer-ui",
            "spk-reviewer-ux",
            "spk-reviewer-backend-python",
            "spk-reviewer-python-quality",
            "spk-reviewer-tests",
            "spk-reviewer-devops",
            "spk-reviewer-database",
            "spk-reviewer-docs"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "security",
            "frontend",
            "ui_design",
            "ux_accessibility",
            "backend",
            "code_quality",
            "testing",
            "infrastructure",
            "database",
            "documentation"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "description": "One entry for every file the agent was assigned. A file that is not listed counts as not reviewed.",
      "items": { "$ref": "review-common-schema.json#/$defs/fileStatus" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "review-common-schema.json#/$defs/finding" }
    },
    "context_unavailable": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Context the agent needed and could not read, such as a caller outside the snapshot or a missing convention file. Reported, never guessed."
    },
    "notes": {
      "type": "string",
      "description": "Optional one or two sentences for the aggregator. Never rendered on GitHub."
    }
  }
}
